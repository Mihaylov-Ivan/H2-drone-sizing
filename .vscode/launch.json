{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Current File",
      "type": "python",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "python": "${command:python.interpreterPath}"
    },
    {
      "name": "Python: script.py",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/script.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "python": "${command:python.interpreterPath}"
    }
  ]
}
